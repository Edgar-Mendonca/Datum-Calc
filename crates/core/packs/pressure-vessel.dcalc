{
 "format": 1,
 "name": "Thin-walled pressure vessel",
 "title": {
  "project": "",
  "number": "PACK-07",
  "title": "Thin-walled pressure vessel",
  "by": "",
  "checked": "",
  "date": "",
  "rev": "A",
  "company": "",
  "client": "",
  "logo": ""
 },
 "page": {
  "paper": "A4",
  "margins": [
   15.0,
   15.0,
