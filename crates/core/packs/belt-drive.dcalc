{
 "format": 1,
 "name": "Flat belt drive: tensions and length",
 "title": {
  "project": "",
  "number": "PACK-25",
  "title": "Flat belt drive: tensions and length",
  "by": "",
  "checked": "",
  "date": "",
  "rev": "A",
  "company": "",
  "client": "",
  "logo": ""
 },
 "page": {
  "paper": "A4",
  "margins": [
   15.0,
