  ]
 },
 "units": "SI",
 "digits": 4,
 "regions": [
  {
   "id": 1,
   "kind": "text",
   "text": "Cable voltage drop (three-phase)",
   "unit": "",
   "style": "heading",
   "data": null
  },
  {
   "id": 2,
   "kind": "text",
   "text": "Balanced three-phase load on a copper cable. ΔV = √3 I L (R cos φ + X sin φ), with R and X per unit length at the operating temperature.",
   "unit": "",
   "style": "note",
   "data": null
  },
  {
   "id": 3,
   "kind": "text",
   "text": "Inputs",
   "unit": "",
   "style": "heading",
   "data": null
  },
  {
   "id": 4,
   "kind": "math",
   "text": "I = 132.5 A  # load current (75 kW motor at full load)",
   "unit": "",
   "style": "input",
   "data": null
  },
  {
   "id": 5,
   "kind": "math",
   "text": "L = 80 m  # route length",
   "unit": "",
   "style": "input",
   "data": null
  },
  {
   "id": 6,
   "kind": "math",
   "text": "R = 0.193 ohm/km  # resistance at 90 °C, 95 mm² copper",
   "unit": "",
   "style": "input",
   "data": null
  },
  {
   "id": 7,
   "kind": "math",
   "text": "X = 0.08 ohm/km  # reactance",
   "unit": "",
   "style": "input",
   "data": null
  },
  {
   "id": 8,
   "kind": "math",
   "text": "PF = 0.86  # power factor of the load",
   "unit": "",
   "style": "input",
   "data": null
  },
  {
   "id": 9,
   "kind": "math",
   "text": "V_L = 400 V  # line voltage",
   "unit": "",
   "style": "input",
   "data": null
  },
  {
   "id": 10,
   "kind": "math",
   "text": "dV_max = 3 %  # allowed voltage drop",
   "unit": "",
   "style": "input",
   "data": null
  },
  {
   "id": 11,
   "kind": "text",
   "text": "Results",
   "unit": "",
   "style": "heading",
   "data": null
  },
  {
   "id": 12,
   "kind": "math",
   "text": "sin_phi = sqrt(1 - PF^2)",
   "unit": "",
   "style": "",
   "data": null
  },
  {
   "id": 13,
   "kind": "math",
   "text": "dV = sqrt(3)*I*L*(R*PF + X*sin_phi)  # voltage drop",
   "unit": "V",
   "style": "",
   "data": null
  },
  {
   "id": 14,
   "kind": "math",
   "text": "dV_pct = dV/V_L  # as a share of the line voltage",
   "unit": "%",
   "style": "",
   "data": null
  },
  {
   "id": 15,
   "kind": "check",
   "text": "check dV_pct <= dV_max",
   "unit": "",
   "style": "",
   "data": null
  },
  {
   "id": 16,
   "kind": "text",
   "text": "Ref: IEC 60364-5-52, Annex G: voltage drop in consumers' installations; R and X from the cable maker's data.",
   "unit": "",
   "style": "ref",
   "data": null
  }
 ],
 "next_id": 17,
 "ui": {
  "pack": {
   "id": "cable-drop",
   "field": "Electrical",
   "desc": "Voltage drop along a three-phase cable from its resistance and reactance per km, as a percentage of the line voltage, against a limit."
  }
 }
}
