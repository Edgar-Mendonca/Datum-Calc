 "format": 1,
 "name": "Cable voltage drop (three-phase)",
 "title": {
  "project": "",
  "number": "PACK-16",
  "title": "Cable voltage drop (three-phase)",
  "by": "",
  "checked": "",
  "date": "",
  "rev": "A",
  "company": "",
