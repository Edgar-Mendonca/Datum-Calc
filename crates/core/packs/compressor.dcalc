{
 "format": 1,
 "name": "Compressor polytropic head and power",
 "title": {
  "project": "",
  "number": "PACK-05",
  "title": "Compressor polytropic head and power",
  "by": "",
  "checked": "",
  "date": "",
  "rev": "A",
  "company": "",
  "client": "",
  "logo": ""
 },
 "page": {
  "paper": "A4",
  "margins": [
   15.0,
