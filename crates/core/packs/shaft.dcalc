{
 "format": 1,
 "name": "Shaft torsion: stress, size and twist",
 "title": {
  "project": "",
  "number": "PACK-11",
  "title": "Shaft torsion: stress, size and twist",
  "by": "",
  "checked": "",
  "date": "",
  "rev": "A",
  "company": "",
