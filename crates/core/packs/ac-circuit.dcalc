 "name": "AC circuit: impedance, current and power factor",
 "title": {
  "project": "",
  "number": "PACK-17",
  "title": "AC circuit: impedance, current and power factor",
  "by": "",
  "checked": "",
  "date": "",
  "rev": "A",
