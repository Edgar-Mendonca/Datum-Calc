  ]
 },
 "units": "SI",
 "digits": 4,
 "regions": [
  {
   "id": 1,
   "kind": "text",
   "text": "Bolted flange: bolt area for operating and seating",
   "unit": "",
   "style": "heading",
   "data": null
  },
  {
   "id": 2,
   "kind": "text",
   "text": "Two loads size the bolts of a gasketed flange: the operating load (the pressure end force plus the load that keeps the gasket tight) and the seating load (to compress the gasket at assembly). The bolt area must carry the larger of the two at its allowable stress. Areas are thread root areas, as the code uses.",
   "unit": "",
   "style": "note",
   "data": null
  },
  {
   "id": 3,
   "kind": "text",
   "text": "Inputs",
   "unit": "",
   "style": "heading",
   "data": null
  },
  {
   "id": 4,
   "kind": "math",
   "text": "P = 2 MPa  # design pressure",
   "unit": "",
   "style": "input",
   "data": null
  },
  {
   "id": 5,
   "kind": "math",
   "text": "G = 200 mm  # diameter at the gasket load reaction",
   "unit": "",
   "style": "input",
   "data": null
  },
  {
   "id": 6,
   "kind": "math",
   "text": "b = 8 mm  # effective gasket seating width",
   "unit": "",
   "style": "input",
   "data": null
  },
  {
   "id": 7,
   "kind": "math",
   "text": "m = 3.0  # gasket factor (spiral-wound, stainless, filled)",
   "unit": "",
   "style": "input",
   "data": null
  },
  {
   "id": 8,
   "kind": "math",
   "text": "y = 69 MPa  # gasket seating stress",
   "unit": "",
   "style": "input",
   "data": null
  },
  {
   "id": 9,
   "kind": "math",
   "text": "S_b = 172 MPa  # allowable bolt stress at the design temperature",
   "unit": "",
   "style": "input",
   "data": null
  },
  {
   "id": 10,
   "kind": "math",
   "text": "S_a = 172 MPa  # allowable bolt stress at ambient temperature",
   "unit": "",
   "style": "input",
   "data": null
  },
  {
   "id": 11,
   "kind": "math",
   "text": "n = 12  # number of bolts",
   "unit": "",
   "style": "input",
   "data": null
  },
  {
   "id": 12,
   "kind": "math",
   "text": "A_r = 225.2 mm^2  # root area of one M20 bolt (minor diameter 16.93 mm)",
   "unit": "",
   "style": "input",
   "data": null
  },
  {
   "id": 13,
   "kind": "text",
   "text": "Results",
   "unit": "",
   "style": "heading",
   "data": null
  },
  {
   "id": 14,
   "kind": "math",
   "text": "H = pi/4*G^2*P  # pressure end force",
   "unit": "",
   "style": "",
   "data": null
  },
  {
   "id": 15,
   "kind": "math",
   "text": "H_p = 2*b*pi*G*m*P  # load that keeps the gasket tight",
   "unit": "",
   "style": "",
   "data": null
  },
  {
   "id": 16,
   "kind": "math",
   "text": "W_m1 = H + H_p  # operating bolt load",
   "unit": "",
   "style": "",
   "data": null
  },
  {
   "id": 17,
   "kind": "math",
   "text": "W_m2 = pi*b*G*y  # gasket seating load",
   "unit": "",
   "style": "",
   "data": null
  },
  {
   "id": 18,
   "kind": "math",
   "text": "A_m = max(W_m1/S_b, W_m2/S_a)  # bolt area needed",
   "unit": "",
   "style": "",
   "data": null
  },
  {
   "id": 19,
   "kind": "math",
   "text": "A_b = n*A_r  # bolt area provided",
   "unit": "",
   "style": "",
   "data": null
  },
  {
   "id": 20,
   "kind": "check",
   "text": "check A_m <= A_b",
   "unit": "",
   "style": "",
   "data": null
  },
  {
   "id": 21,
   "kind": "text",
   "text": "Ref: ASME Boiler and Pressure Vessel Code, Section VIII Division 1, Mandatory Appendix 2, 2-5: the loads W_m1 and W_m2 and the required bolt area; Table 2-5.1: gasket factors m and y.",
   "unit": "",
   "style": "ref",
   "data": null
  }
 ],
 "next_id": 22,
 "ui": {
  "pack": {
   "id": "flange-bolts",
   "field": "Mechanical",
   "desc": "The bolt load to keep a gasketed flange tight under pressure and to seat its gasket, and the bolt area needed against the bolt area provided."
  }
 }
}
