{
 "format": 1,
 "name": "Bolted flange: bolt area for operating and seating",
 "title": {
  "project": "",
  "number": "PACK-21",
  "title": "Bolted flange: bolt area for operating and seating",
  "by": "",
  "checked": "",
  "date": "",
  "rev": "A",
  "company": "",
  "client": "",
  "logo": ""
 },
 "page": {
