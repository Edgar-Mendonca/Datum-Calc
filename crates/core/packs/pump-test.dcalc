  "regions": [
    {
      "id": 1,
      "kind": "text",
      "text": "Pump curve from test data",
      "unit": "",
      "style": "heading",
      "data": null
    },
    {
      "id": 2,
      "kind": "text",
      "text": "The pump’s test points are in the table (paste them from a spreadsheet, or Insert › From CSV). A quadratic is fitted through them by least squares; the system curve is the static head plus a friction term that passes through the design point. The pump runs where the two meet.",
      "unit": "",
      "style": "note",
      "data": null
    },
    {
      "id": 3,
      "kind": "table",
      "text": "Pump test",
      "unit": "",
      "style": "",
      "data": {
        "cols": [
          {
            "name": "Q",
            "unit": "m^3/h",
            "formula": ""
          },
          {
            "name": "H",
            "unit": "m",
            "formula": ""
          }
        ],
        "rows": [
          [
            "0",
            "62.0"
          ],
          [
            "25",
            "61.1"
          ],
          [
            "50",
            "58.0"
          ],
          [
            "75",
            "52.6"
          ],
          [
            "100",
            "45.1"
          ],
          [
            "125",
            "35.2"
          ]
        ]
      }
    },
    {
      "id": 4,
      "kind": "text",
      "text": "Inputs",
      "unit": "",
      "style": "subheading",
      "data": null
    },
    {
      "id": 5,
      "kind": "math",
      "text": "H_st = 15 m  # static head",
      "unit": "",
      "style": "input",
      "data": null
    },
    {
      "id": 6,
      "kind": "math",
      "text": "Q_d = 90 m^3/h  # design flow",
      "unit": "",
      "style": "input",
      "data": null
    },
    {
      "id": 7,
      "kind": "math",
      "text": "H_d = 38 m  # head the system needs at the design flow",
      "unit": "",
      "style": "input",
      "data": null
    },
    {
      "id": 8,
      "kind": "text",
      "text": "Curves",
      "unit": "",
      "style": "subheading",
      "data": null
    },
    {
      "id": 9,
      "kind": "math",
      "text": "fit H_p(q) = a + b*q + c*q^2 to Q, H  # pump curve",
      "unit": "",
      "style": "",
      "data": null
    },
    {
      "id": 10,
      "kind": "math",
      "text": "k = (H_d - H_st)/Q_d^2",
      "unit": "",
      "style": "",
      "data": null
    },
    {
      "id": 11,
      "kind": "math",
      "text": "H_s(q) = H_st + k*q^2  # system curve",
      "unit": "",
      "style": "",
      "data": null
    },
    {
      "id": 12,
      "kind": "text",
      "text": "Operating point",
      "unit": "",
      "style": "subheading",
      "data": null
    },
    {
      "id": 13,
      "kind": "solve",
      "text": "solve H_p(Q_op) = H_s(Q_op) for Q_op in 1 m^3/h .. 150 m^3/h",
      "unit": "",
      "style": "",
      "data": null
    },
    {
      "id": 14,
      "kind": "math",
      "text": "H_op = H_s(Q_op)",
      "unit": "",
      "style": "",
      "data": null
    },
    {
      "id": 15,
      "kind": "check",
      "text": "check Q_op >= Q_d",
      "unit": "",
      "style": "",
      "data": null
    },
    {
      "id": 16,
      "kind": "plot",
      "text": "plot H_p(q), H_s(q), points(Q, H) for q in 0 m^3/h .. 140 m^3/h",
      "unit": "",
      "style": "",
      "data": null
    },
    {
      "id": 17,
      "kind": "text",
      "text": "Ref: I. J. Karassik et al., Pump Handbook, 4th ed., ch. 2 (pump and system curves, the operating point).",
      "unit": "",
      "style": "ref",
      "data": null
    },
    {
      "id": 18,
      "kind": "text",
      "text": "Ref: least squares by the QR method: G. H. Golub and C. F. Van Loan, Matrix Computations, 4th ed., §5.3.",
      "unit": "",
      "style": "ref",
      "data": null
    }
  ],
  "next_id": 19,
