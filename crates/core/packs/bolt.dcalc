{
 "format": 1,
 "name": "Bolt preload and tightening torque",
 "title": {
  "project": "",
  "number": "PACK-09",
  "title": "Bolt preload and tightening torque",
  "by": "",
  "checked": "",
  "date": "",
  "rev": "A",
  "company": "",
  "client": "",
  "logo": ""
 },
 "page": {
  "paper": "A4",
  "margins": [
   15.0,
   15.0,
