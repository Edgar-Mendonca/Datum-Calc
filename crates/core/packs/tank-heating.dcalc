{
 "format": 1,
 "name": "Tank heating time with heat losses",
 "title": {
  "project": "",
  "number": "PACK-22",
  "title": "Tank heating time with heat losses",
  "by": "",
  "checked": "",
  "date": "",
  "rev": "A",
  "company": "",
  "client": "",
  "logo": ""
 },
 "page": {
  "paper": "A4",
  "margins": [
   15.0,
