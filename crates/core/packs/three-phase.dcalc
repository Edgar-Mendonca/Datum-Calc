{
 "format": 1,
 "name": "Three-phase load: current and power-factor correction",
 "title": {
  "project": "",
  "number": "PACK-23",
  "title": "Three-phase load: current and power-factor correction",
  "by": "",
  "checked": "",
  "date": "",
  "rev": "A",
