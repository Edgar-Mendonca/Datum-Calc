{
 "format": 1,
 "name": "Helical compression spring: rate and stress",
 "title": {
  "project": "",
  "number": "PACK-24",
  "title": "Helical compression spring: rate and stress",
  "by": "",
  "checked": "",
  "date": "",
  "rev": "A",
