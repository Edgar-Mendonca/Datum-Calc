{
  "format": 1,
  "name": "Steam turbine: Rankine cycle",
  "title": {
    "project": "",
    "number": "PACK-28",
    "title": "Steam turbine: Rankine cycle",
    "by": "",
    "checked": "",
    "date": "",
    "rev": "A",
    "company": "",
    "client": "",
    "logo": ""
  },
  "page": {
    "paper": "A4",
    "margins": [
      15.0,
      15.0,
