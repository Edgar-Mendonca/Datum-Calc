{
 "format": 1,
 "name": "Heat exchanger duty and LMTD",
 "title": {
  "project": "",
  "number": "PACK-06",
  "title": "Heat exchanger duty and LMTD",
  "by": "",
  "checked": "",
  "date": "",
  "rev": "A",
